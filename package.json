{
  "name": "telegramspinwheel",
  "version": "1.0.0",
  "description": "Telegram spin wheel bot that splits chat members into random groups",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "userbot:login": "tsx scripts/userbot-login.ts",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "Narihito",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@grammyjs/storage-prisma": "^2.6.0",
    "@prisma/client": "^6.19.3",
    "@vercel/og": "^0.8.5",
    "grammy": "^1.46.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
