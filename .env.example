# Bot token from @BotFather
BOT_TOKEN=

# Random string, Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=

# Public URL of the Vercel deployment, used by scripts/set-webhook.ts (e.g. https://your-app.vercel.app)
WEBHOOK_URL=

# Postgres connection string (Neon)
DATABASE_URL=
