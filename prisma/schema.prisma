generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chat {
  id          BigInt    @id
  title       String
  type        String
  addedById   BigInt?
  active      Boolean   @default(true)
  lastWheelAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  spins       Spin[]
}

model Session {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Spin {
  id            Int      @id @default(autoincrement())
  chatId        BigInt
  requestedById BigInt
  teamCount     Int
  teamSize      Int
  teams         Json
  leftovers     Json
  createdAt     DateTime @default(now())
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
